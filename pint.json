{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "strict_comparison": true,
        "native_function_invocation": false,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        }
    }
}
